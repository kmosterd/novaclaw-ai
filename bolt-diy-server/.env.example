# bolt.diy — API-sleutels
#
# Dit bestand wordt door 01-install.sh gekopieerd naar ~/bolt-diy/.env.
# Bewerk daarna ALTIJD ~/bolt-diy/.env (chmod 600) en nooit dit voorbeeld:
# dit bestand staat in git, dat andere niet.
#
# Je hebt minstens één sleutel nodig. Sleutels kun je ook in de bolt.diy-UI
# invullen (tandwiel > Providers); die worden dan in je browser opgeslagen in
# plaats van op de server. Zet je ze hier, dan gelden ze voor iedereen die de
# server kan bereiken.
#
# Na wijzigen herstarten:  make restart

# --- OpenRouter: de enige sleutel die je nodig hebt -------------------------
# Eén sleutel, één rekening, toegang tot vrijwel elk model (Claude, GPT,
# Gemini, DeepSeek, Qwen, ...). De modellenlijst in bolt.diy wordt live bij
# OpenRouter opgehaald, inclusief de prijs per model.
#
# Sleutel maken: https://openrouter.ai/settings/keys
# Zet daar meteen een uitgavenlimiet — zie docs/openrouter.md.
OPEN_ROUTER_API_KEY=

# --- Rechtstreeks bij een provider (optioneel) ------------------------------
# Alleen invullen als je een provider buiten OpenRouter om wilt gebruiken.
# Rechtstreeks is iets goedkoper; via OpenRouter heb je één rekening en kun je
# zonder nieuwe sleutel van model wisselen.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=
COHERE_API_KEY=
PERPLEXITY_API_KEY=
CEREBRAS_API_KEY=
FIREWORKS_API_KEY=
MOONSHOT_API_KEY=
HuggingFace_API_KEY=
HYPERBOLIC_API_KEY=
GITHUB_API_KEY=

# --- Lokale modellen -------------------------------------------------------
# Draai je Ollama of LM Studio op dezelfde Mac mini, haal dan het commentaar weg.
# OLLAMA_API_BASE_URL=http://127.0.0.1:11434
# LMSTUDIO_API_BASE_URL=http://127.0.0.1:1234

# --- Integraties (optioneel) -----------------------------------------------
# Nodig om vanuit bolt.diy naar GitHub te pushen of naar Netlify te deployen.
# Vercel is bewust weggelaten; wil je het toch, voeg dan VITE_VERCEL_ACCESS_TOKEN toe.
# VITE_GITHUB_ACCESS_TOKEN=
# VITE_GITHUB_TOKEN_TYPE=fine-grained
# VITE_NETLIFY_ACCESS_TOKEN=

# --- Instellingen ----------------------------------------------------------
# Contextvenster voor lokale modellen. Hoger = meer geheugengebruik.
DEFAULT_NUM_CTX=32768

# Logniveau: debug, info, warn, error
VITE_LOG_LEVEL=info
